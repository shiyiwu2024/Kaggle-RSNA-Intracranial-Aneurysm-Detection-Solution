class DataPreprocessor:
    """Preprocess all data and save to disk"""
    
    def __init__(self, config):
        self.cfg = config
        self.label_cols = [
            'Left Infraclinoid Internal Carotid Artery',
            'Right Infraclinoid Internal Carotid Artery',
            'Left Supraclinoid Internal Carotid Artery',
            'Right Supraclinoid Internal Carotid Artery',
            'Left Middle Cerebral Artery',
            'Right Middle Cerebral Artery',
            'Anterior Communicating Artery',
            'Left Anterior Cerebral Artery',
            'Right Anterior Cerebral Artery',
            'Left Posterior Communicating Artery',
            'Right Posterior Communicating Artery',
            'Basilar Tip',
            'Other Posterior Circulation',
            'Aneurysm Present',
        ]
        
        # Create directories
        os.makedirs(self.cfg.PREPROCESSED_TRAIN, exist_ok=True)
        os.makedirs(self.cfg.PREPROCESSED_VALID, exist_ok=True)
    
    def parse_coordinates(self, coord_str):
        """Parse coordinate string"""
        try:
            coords = eval(coord_str)
            return coords[0], coords[1]
        except:
            return None, None
    
    def load_segmentation(self, series_id):
        """Load NIfTI vessel segmentation"""
        try:
            seg_path = os.path.join(self.cfg.SEGMENTATION_DIR, f"{series_id}.nii")
            if not os.path.exists(seg_path):
                return None
            
            nii = nib.load(seg_path)
            seg_data = nii.get_fdata()
            
            if len(seg_data.shape) == 3:
                n = seg_data.shape[2]
                if n > self.cfg.NUM_SLICES:
                    idx = np.linspace(0, n-1, self.cfg.NUM_SLICES, dtype=int)
                    seg_data = seg_data[:, :, idx]
                elif n < self.cfg.NUM_SLICES:
                    pad = self.cfg.NUM_SLICES - n
                    seg_data = np.pad(seg_data, ((0,0), (0,0), (0,pad)), mode='edge')
                
                seg_data = np.transpose(seg_data, (2, 0, 1))
            
            seg_data = seg_data.astype(np.float32)
            if seg_data.max() > 0:
                seg_data = seg_data / seg_data.max()
            
            resized = []
            for i in range(self.cfg.NUM_SLICES):
                img = Image.fromarray((seg_data[i] * 255).astype(np.uint8))
                img = img.resize((self.cfg.IMAGE_SIZE, self.cfg.IMAGE_SIZE), Image.BILINEAR)
                resized.append(np.array(img) / 255.0)
            
            return np.stack(resized, axis=0).astype(np.float32)
        except:
            return None
    
    def create_localization_map(self, series_id, instance_to_slice_idx, localizers_lookup):
        """Create spatial heat map from coordinates"""
        loc_map = np.zeros((self.cfg.NUM_SLICES, self.cfg.IMAGE_SIZE, self.cfg.IMAGE_SIZE), dtype=np.float32)
        
        if series_id not in localizers_lookup:
            return loc_map
        
        for loc_info in localizers_lookup[series_id]:
            sop_id = loc_info['sop_id']
            x, y = self.parse_coordinates(loc_info['coordinates'])
            
            if x is None or sop_id not in instance_to_slice_idx:
                continue
            
            slice_idx = instance_to_slice_idx[sop_id]
            if slice_idx >= self.cfg.NUM_SLICES:
                continue
            
            x_scaled = int(x * self.cfg.IMAGE_SIZE / 512)
            y_scaled = int(y * self.cfg.IMAGE_SIZE / 512)
            
            y_grid, x_grid = np.ogrid[:self.cfg.IMAGE_SIZE, :self.cfg.IMAGE_SIZE]
            sigma = self.cfg.IMAGE_SIZE // 20
            gaussian = np.exp(-((x_grid - x_scaled)**2 + (y_grid - y_scaled)**2) / (2 * sigma**2))
            
            loc_map[slice_idx] = np.maximum(loc_map[slice_idx], gaussian)
        
        return loc_map
    
    def load_dicom_series(self, series_id):
        """Load DICOM series with robust error handling"""
        try:
            series_path = os.path.join(self.cfg.DATA_DIR, series_id)
            if not os.path.exists(series_path):
                return None, {}
            
            dcm_files = []
            for root, _, files in os.walk(series_path):
                for f in files:
                    if f.endswith('.dcm'):
                        dcm_files.append(os.path.join(root, f))
            
            if not dcm_files:
                return None, {}
            
            slices = []
            corrupted_count = 0
            
            for f in dcm_files:
                try:
                    # Try to read DICOM with robust settings
                    ds = pydicom.dcmread(f, force=True)
                    instance_num = int(getattr(ds, 'InstanceNumber', 0))
                    sop_id = getattr(ds, 'SOPInstanceUID', '')
                    
                    # Get pixel array with error handling
                    try:
                        pixels = ds.pixel_array
                    except:
                        corrupted_count += 1
                        continue
                    
                    # Validate pixel array
                    if len(pixels.shape) != 2:
                        corrupted_count += 1
                        continue
                    
                    if pixels.size == 0:
                        corrupted_count += 1
                        continue
                    
                    pixels = pixels.astype(np.float32)
                    
                    # Apply rescale with error handling
                    try:
                        slope = float(getattr(ds, 'RescaleSlope', 1))
                        intercept = float(getattr(ds, 'RescaleIntercept', 0))
                        if not (np.isnan(slope) or np.isinf(slope) or slope == 0):
                            pixels = pixels * slope + intercept
                    except:
                        pass  # Use pixels as is
                    
                    # Check for invalid values
                    if np.isnan(pixels).all() or np.isinf(pixels).all():
                        corrupted_count += 1
                        continue
                    
                    slices.append((instance_num, sop_id, pixels))
                    
                except Exception:
                    corrupted_count += 1
                    continue
            
            # Need at least some valid slices
            if len(slices) == 0:
                return None, {}
            
            # If too many files are corrupted, might want to skip this series
            if corrupted_count > len(dcm_files) * 0.5:  # More than 50% corrupted
                return None, {}
            
            slices.sort(key=lambda x: x[0])
            
            # Sample slices
            n = len(slices)
            if n > self.cfg.NUM_SLICES:
                idx = np.linspace(0, n-1, self.cfg.NUM_SLICES, dtype=int)
                selected_slices = [slices[i] for i in idx]
            else:
                selected_slices = slices
            
            instance_to_slice = {s[1]: i for i, s in enumerate(selected_slices)}
            volume = np.stack([s[2] for s in selected_slices], axis=0)
            
            # Pad if needed
            if len(volume) < self.cfg.NUM_SLICES:
                pad = self.cfg.NUM_SLICES - len(volume)
                volume = np.pad(volume, ((0, pad), (0, 0), (0, 0)), mode='edge')
            
            # Normalize with robust handling
            try:
                vmin, vmax = np.nanpercentile(volume, [1, 99])  # Use percentiles to be robust
                if vmax > vmin and not (np.isnan(vmin) or np.isnan(vmax)):
                    volume = (volume - vmin) / (vmax - vmin)
                    volume = np.clip(volume, 0, 1)
                else:
                    volume = np.zeros_like(volume)
            except:
                volume = np.zeros_like(volume)
            
            # Replace any remaining NaN/Inf
            volume = np.nan_to_num(volume, nan=0.0, posinf=1.0, neginf=0.0)
            
            # Resize
            resized = []
            for i in range(self.cfg.NUM_SLICES):
                try:
                    img = Image.fromarray((volume[i] * 255).astype(np.uint8))
                    img = img.resize((self.cfg.IMAGE_SIZE, self.cfg.IMAGE_SIZE), Image.BILINEAR)
                    resized.append(np.array(img) / 255.0)
                except:
                    # If resize fails, add zeros
                    resized.append(np.zeros((self.cfg.IMAGE_SIZE, self.cfg.IMAGE_SIZE), dtype=np.float32))
            
            result_volume = np.stack(resized, axis=0).astype(np.float32)
            
            # Final validation
            if np.isnan(result_volume).any() or np.isinf(result_volume).any():
                return None, {}
            
            return result_volume, instance_to_slice
            
        except Exception as e:
            # Catch-all for any unexpected errors
            return None, {}
    
    def preprocess_and_save(self, df, localizers_df, output_dir, split_name):
        """Preprocess all samples and save"""
        import sys
        print(f"\n{'='*60}")
        print(f"Preprocessing {split_name} data...")
        print(f"{'='*60}")
        sys.stdout.flush()
        
        # Create localizers lookup
        localizers_lookup = {}
        if localizers_df is not None:
            for _, row in localizers_df.iterrows():
                series_id = row['SeriesInstanceUID']
                if series_id not in localizers_lookup:
                    localizers_lookup[series_id] = []
                localizers_lookup[series_id].append({
                    'sop_id': row['SOPInstanceUID'],
                    'coordinates': row['coordinates'],
                    'location': row['location']
                })
        
        successful = 0
        failed = 0
        metadata = []
        total = len(df)
        error_counts = {}
        
        print(f"Total samples to process: {total}")
        print(f"Progress updates every 100 samples...")
        sys.stdout.flush()
        
        # Process with detailed logging
        for idx, (df_idx, row) in enumerate(df.iterrows(), 1):
            series_id = row['SeriesInstanceUID']
            
            # Print progress every 100 samples
            if idx % 100 == 0:
                elapsed_pct = idx / total * 100
                print(f"[{split_name}] {idx}/{total} ({elapsed_pct:.1f}%) | ✓ Success: {successful} | ✗ Failed: {failed}")
                sys.stdout.flush()
            
            try:
                # Load DICOM with error handling
                volume, instance_map = self.load_dicom_series(series_id)
                if volume is None:
                    failed += 1
                    error_counts['dicom_load_failed'] = error_counts.get('dicom_load_failed', 0) + 1
                    continue
                
                # Verify volume is valid
                if np.isnan(volume).any() or np.isinf(volume).any():
                    failed += 1
                    error_counts['invalid_values'] = error_counts.get('invalid_values', 0) + 1
                    continue
                
                # Load segmentation with error handling
                try:
                    segmentation = self.load_segmentation(series_id)
                    if segmentation is None:
                        segmentation = np.zeros_like(volume)
                except Exception as e:
                    segmentation = np.zeros_like(volume)
                    error_counts['segmentation_error'] = error_counts.get('segmentation_error', 0) + 1
                
                # Create localization map with error handling
                try:
                    loc_map = self.create_localization_map(series_id, instance_map, localizers_lookup)
                except Exception as e:
                    loc_map = np.zeros_like(volume)
                    error_counts['localization_error'] = error_counts.get('localization_error', 0) + 1
                
                # Get labels
                labels = row[self.label_cols].values.astype(np.float32)
                
                # Verify all data shapes match
                if not (volume.shape == segmentation.shape == loc_map.shape):
                    failed += 1
                    error_counts['shape_mismatch'] = error_counts.get('shape_mismatch', 0) + 1
                    continue
                
                # Save as compressed numpy
                save_path = os.path.join(output_dir, f"{series_id}.npz")
                np.savez_compressed(
                    save_path,
                    volume=volume,
                    segmentation=segmentation,
                    localization=loc_map,
                    labels=labels
                )
                
                # Store metadata
                metadata.append({
                    'series_id': series_id,
                    'file_path': save_path,
                    'has_aneurysm': int(labels[-1])
                })
                
                successful += 1
                
            except Exception as e:
                failed += 1
                error_type = type(e).__name__
                error_counts[error_type] = error_counts.get(error_type, 0) + 1
                
                # Print occasional error samples
                if failed <= 5:
                    print(f"  Error on sample {idx} ({series_id[:20]}...): {error_type}: {str(e)[:60]}")
                    sys.stdout.flush()
                continue
        
        # Final summary
        print(f"\n{split_name} preprocessing complete:")
        print(f"  ✓ Successful: {successful} ({successful/total*100:.1f}%)")
        print(f"  ✗ Failed: {failed} ({failed/total*100:.1f}%)")
        
        if error_counts:
            print(f"\n  Error breakdown:")
            for error_type, count in sorted(error_counts.items(), key=lambda x: x[1], reverse=True):
                print(f"    - {error_type}: {count}")
        
        if successful > 0:
            approx_size = successful * volume.nbytes / 1e9
            print(f"\n  Approximate total size: {approx_size:.2f} GB (uncompressed)")
        
        sys.stdout.flush()
        return metadata
    
    def run(self):
        """Run full preprocessing pipeline"""
        import sys
        print("\n" + "="*60)
        print("STARTING DATA PREPROCESSING")
        print(f"Time: {time.strftime('%H:%M:%S')}")
        print("="*60)
        sys.stdout.flush()
        
        # Load CSVs
        print("\nLoading CSV files...")
        sys.stdout.flush()
        df = pd.read_csv(self.cfg.TRAIN_CSV)
        print(f"Total samples: {len(df)}")
        
        localizers_df = None
        if os.path.exists(self.cfg.LOCALIZERS_CSV):
            localizers_df = pd.read_csv(self.cfg.LOCALIZERS_CSV)
            print(f"Localizers: {len(localizers_df)} annotations")
        sys.stdout.flush()
        
        # Subset for testing
        if self.cfg.USE_SUBSET:
            df = df.sample(n=min(self.cfg.USE_SUBSET, len(df)), random_state=self.cfg.SEED)
            print(f"Using subset: {len(df)} samples")
        
        # Train/Valid split
        train_df, valid_df = train_test_split(
            df, test_size=0.15, random_state=self.cfg.SEED, 
            stratify=df['Aneurysm Present']
        )
        print(f"\nSplit: Train={len(train_df)}, Valid={len(valid_df)}")
        sys.stdout.flush()
        
        # Preprocess train
        start_time = time.time()
        train_metadata = self.preprocess_and_save(
            train_df, localizers_df, self.cfg.PREPROCESSED_TRAIN, 'TRAIN'
        )
        train_time = time.time() - start_time
        print(f"Train preprocessing took {train_time/60:.1f} minutes")
        sys.stdout.flush()
        
        # Preprocess valid
        start_time = time.time()
        valid_metadata = self.preprocess_and_save(
            valid_df, localizers_df, self.cfg.PREPROCESSED_VALID, 'VALID'
        )
        valid_time = time.time() - start_time
        print(f"Valid preprocessing took {valid_time/60:.1f} minutes")
        sys.stdout.flush()
        
        # Save metadata
        metadata = {
            'train': train_metadata,
            'valid': valid_metadata,
            'config': {
                'num_slices': self.cfg.NUM_SLICES,
                'image_size': self.cfg.IMAGE_SIZE,
                'num_classes': self.cfg.NUM_CLASSES,
                'label_cols': self.label_cols
            }
        }
        
        with open(self.cfg.METADATA_FILE, 'wb') as f:
            pickle.dump(metadata, f)
        
        print(f"\n✓ Metadata saved to {self.cfg.METADATA_FILE}")
        print("\n" + "="*60)
        print("PREPROCESSING COMPLETE!")
        print(f"Total time: {(train_time + valid_time)/60:.1f} minutes")
        print("="*60)
        print("\n💾 To save preprocessed data for future use:")
        print("   !zip -r preprocessed_data.zip preprocessed_data/")
        print("   Download the zip and upload as a Kaggle dataset")
        print("\n▶️  Now run the training cells below!")
        sys.stdout.flush()

# Run preprocessing
preprocessor = DataPreprocessor(CFG)
preprocessor.run()


