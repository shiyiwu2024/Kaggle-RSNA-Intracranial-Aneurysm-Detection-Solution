class PreprocessedDataset(Dataset):
    """Load preprocessed data directly from disk"""
    
    def __init__(self, metadata_list, augment=False):
        self.metadata = metadata_list
        self.augment = augment
    
    def __len__(self):
        return len(self.metadata)
    
    def augment_volume(self, volume, segmentation, localization):
        """Fast augmentation on preprocessed data"""
        # Horizontal flip
        if np.random.rand() > 0.5:
            volume = np.flip(volume, axis=2).copy()
            segmentation = np.flip(segmentation, axis=2).copy()
            localization = np.flip(localization, axis=2).copy()
        
        # Vertical flip
        if np.random.rand() > 0.7:
            volume = np.flip(volume, axis=1).copy()
            segmentation = np.flip(segmentation, axis=1).copy()
            localization = np.flip(localization, axis=1).copy()
        
        # Noise
        if np.random.rand() > 0.5:
            noise = np.random.normal(0, 0.02, volume.shape)
            volume = np.clip(volume + noise, 0, 1)
        
        # Brightness
        if np.random.rand() > 0.5:
            factor = np.random.uniform(0.85, 1.15)
            volume = np.clip(volume * factor, 0, 1)
        
        # Contrast
        if np.random.rand() > 0.5:
            mean = volume.mean()
            factor = np.random.uniform(0.85, 1.15)
            volume = np.clip((volume - mean) * factor + mean, 0, 1)
        
        return volume, segmentation, localization
    
    def __getitem__(self, idx):
        try:
            file_path = self.metadata[idx]['file_path']
            
            # Load preprocessed data
            data = np.load(file_path)
            volume = data['volume']
            segmentation = data['segmentation']
            localization = data['localization']
            labels = data['labels']
            
            # Augmentation
            if self.augment:
                volume, segmentation, localization = self.augment_volume(
                    volume, segmentation, localization
                )
            
            return {
                'volume': torch.from_numpy(volume).float(),
                'segmentation': torch.from_numpy(segmentation).float(),
                'localization': torch.from_numpy(localization).float(),
                'labels': torch.from_numpy(labels).float()
            }
        except Exception as e:
            print(f"Error loading {idx}: {e}")
            # Return zeros on error
            return {
                'volume': torch.zeros(CFG.NUM_SLICES, CFG.IMAGE_SIZE, CFG.IMAGE_SIZE),
                'segmentation': torch.zeros(CFG.NUM_SLICES, CFG.IMAGE_SIZE, CFG.IMAGE_SIZE),
                'localization': torch.zeros(CFG.NUM_SLICES, CFG.IMAGE_SIZE, CFG.IMAGE_SIZE),
                'labels': torch.zeros(CFG.NUM_CLASSES)
            }

print("Preprocessed Dataset class defined!")


