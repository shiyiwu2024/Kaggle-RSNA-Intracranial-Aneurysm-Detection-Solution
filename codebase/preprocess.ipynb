# Cell 5: Multi-Modal Vision Transformer Model
# ============================================

class PositionalEncoding3D(nn.Module):
    def __init__(self, d_model, max_len=10):
        super().__init__()
        pe = torch.zeros(max_len, d_model)
        position = torch.arange(0, max_len, dtype=torch.float).unsqueeze(1)
        div_term = torch.exp(torch.arange(0, d_model, 2).float() * (-np.log(10000.0) / d_model))
        pe[:, 0::2] = torch.sin(position * div_term)
        pe[:, 1::2] = torch.cos(position * div_term)
        self.register_buffer('pe', pe)
    
    def forward(self, x):
        return x + self.pe[:x.size(1), :]


class MultiModalFusion(nn.Module):
    def __init__(self, embed_dim):
        super().__init__()
        self.fusion = nn.Sequential(
            nn.Linear(embed_dim * 3, embed_dim * 2),
            nn.GELU(),
            nn.Dropout(0.2),
            nn.Linear(embed_dim * 2, embed_dim),
            nn.LayerNorm(embed_dim)
        )
    
    def forward(self, img_feat, seg_feat, loc_feat):
        combined = torch.cat([img_feat, seg_feat, loc_feat], dim=-1)
        return self.fusion(combined)


class MultiModalTransformerModel(nn.Module):
    def __init__(self, backbone='vit_small_patch16_224', num_slices=8, num_classes=14,
                 embed_dim=384, num_heads=6, transformer_layers=4, dropout=0.35):
        super().__init__()
        
        # Image backbone
        self.img_backbone = timm.create_model(
            backbone, pretrained=True, in_chans=1, num_classes=0, global_pool='token'
        )
        
        # Freeze early layers
        for name, param in self.img_backbone.named_parameters():
            if any(x in name for x in ['blocks.0', 'blocks.1', 'blocks.2', 'blocks.3']):
                param.requires_grad = False
        
        # Segmentation encoder
        self.seg_backbone = timm.create_model(
            backbone, pretrained=False, in_chans=1, num_classes=0, global_pool='token'
        )
        for param in self.seg_backbone.parameters():
            param.data *= 0.1
        
        # Localization encoder
        self.loc_backbone = timm.create_model(
            backbone, pretrained=False, in_chans=1, num_classes=0, global_pool='token'
        )
        for param in self.loc_backbone.parameters():
            param.data *= 0.1
        
        self.embed_dim = embed_dim
        self.fusion = MultiModalFusion(embed_dim)
        self.pos_encoding = PositionalEncoding3D(embed_dim, max_len=num_slices)
        
        # Transformer
        encoder_layer = nn.TransformerEncoderLayer(
            d_model=embed_dim, nhead=num_heads,
            dim_feedforward=embed_dim * 3, dropout=dropout,
            activation='gelu', batch_first=True
        )
        self.transformer = nn.TransformerEncoder(encoder_layer, num_layers=transformer_layers)
        
        # Classifier
        self.classifier = nn.Sequential(
            nn.LayerNorm(embed_dim),
            nn.Dropout(dropout),
            nn.Linear(embed_dim, embed_dim // 2),
            nn.GELU(),
            nn.Dropout(dropout),
            nn.Linear(embed_dim // 2, num_classes)
        )
        
        # Localization head
        self.loc_refiner = nn.Sequential(
            nn.LayerNorm(embed_dim),
            nn.Linear(embed_dim, embed_dim // 4),
            nn.GELU(),
            nn.Linear(embed_dim // 4, 1)
        )
    
    def forward(self, batch):
        x = batch['volume']
        B, D, H, W = x.shape
        
        # Extract features per slice
        img_features = torch.stack([self.img_backbone(x[:, i:i+1, :, :]) for i in range(D)], dim=1)
        
        seg = batch['segmentation']
        seg_features = torch.stack([self.seg_backbone(seg[:, i:i+1, :, :]) for i in range(D)], dim=1)
        
        loc = batch['localization']
        loc_features = torch.stack([self.loc_backbone(loc[:, i:i+1, :, :]) for i in range(D)], dim=1)
        
        # Fusion
        fused = self.fusion(img_features, seg_features, loc_features)
        fused = self.pos_encoding(fused)
        
        # Transformer
        transformed = self.transformer(fused)
        pooled = transformed.mean(dim=1)
        
        # Outputs
        output = self.classifier(pooled)
        loc_pred = self.loc_refiner(transformed).squeeze(-1)
        
        return output, loc_pred

print("Multi-modal Transformer model defined!")


# ============================================
# Cell 6: Training utilities
# ============================================

def compute_auc(y_true, y_pred):
    aucs = []
    for i in range(y_true.shape[1]):
        try:
            if len(np.unique(y_true[:, i])) >= 2:
                auc = roc_auc_score(y_true[:, i], y_pred[:, i])
                aucs.append(auc)
        except:
            pass
    
    if len(aucs) == 0:
        return 0.0
    
    aneurysm_auc = aucs[-1] if len(aucs) == 14 else np.mean(aucs)
    other_auc = np.mean(aucs[:-1]) if len(aucs) == 14 else np.mean(aucs)
    return (aneurysm_auc + other_auc) / 2


def train_epoch(model, loader, criterion, optimizer, device):
    model.train()
    losses = []
    
    for batch in tqdm(loader, desc='Train'):
        for k in batch:
            batch[k] = batch[k].to(device)
        
        labels = batch['labels']
        
        optimizer.zero_grad()
        outputs, loc_preds = model(batch)
        
        cls_loss = criterion(outputs, labels)
        loss = CFG.CLASSIFICATION_WEIGHT * cls_loss
        
        # Localization loss
        loc_target = batch['localization'].amax(dim=(-2, -1))
        loc_target = (loc_target > 0.1).float()
        loc_loss = nn.BCEWithLogitsLoss()(loc_preds, loc_target)
        loss += CFG.LOCALIZATION_WEIGHT * loc_loss
        
        loss.backward()
        torch.nn.utils.clip_grad_norm_(model.parameters(), max_norm=1.0)
        optimizer.step()
        
        losses.append(loss.item())
    
    return np.mean(losses)


def valid_epoch(model, loader, criterion, device):
    model.eval()
    losses, all_labels, all_preds = [], [], []
    
    with torch.no_grad():
        for batch in tqdm(loader, desc='Valid'):
            for k in batch:
                batch[k] = batch[k].to(device)
            
            labels = batch['labels']
            outputs, _ = model(batch)
            loss = criterion(outputs, labels)
            
            losses.append(loss.item())
            all_labels.append(labels.cpu().numpy())
            all_preds.append(torch.sigmoid(outputs).cpu().numpy())
    
    all_labels = np.vstack(all_labels)
    all_preds = np.vstack(all_preds)
    auc = compute_auc(all_labels, all_preds)
    
    return np.mean(losses), auc

print("Training utilities defined!")


# ============================================
# Cell 7: Load preprocessed data
# ============================================

print("\nLoading preprocessed data...")

# Load metadata
with open(CFG.METADATA_FILE, 'rb') as f:
    metadata = pickle.load(f)

train_metadata = metadata['train']
valid_metadata = metadata['valid']

print(f"Train samples: {len(train_metadata)}")
print(f"Valid samples: {len(valid_metadata)}")

# Create datasets
train_dataset = PreprocessedDataset(train_metadata, augment=True)
valid_dataset = PreprocessedDataset(valid_metadata, augment=False)

# Create dataloaders (can use more workers now!)
train_loader = DataLoader(
    train_dataset, batch_size=CFG.BATCH_SIZE, shuffle=True,
    num_workers=CFG.NUM_WORKERS, pin_memory=True, persistent_workers=True
)
valid_loader = DataLoader(
    valid_dataset, batch_size=CFG.BATCH_SIZE, shuffle=False,
    num_workers=CFG.NUM_WORKERS, pin_memory=True, persistent_workers=True
)

print(f"Train batches: {len(train_loader)}")
print(f"Valid batches: {len(valid_loader)}")
print(f"Estimated epoch time: Much faster without preprocessing! 🚀")


# ============================================
# Cell 8: Initialize model and optimizer
# ============================================

torch.manual_seed(CFG.SEED)
np.random.seed(CFG.SEED)

print("\nCreating Multi-modal Transformer...")
model = MultiModalTransformerModel(
    backbone=CFG.BACKBONE,
    num_slices=CFG.NUM_SLICES,
    num_classes=CFG.NUM_CLASSES,
    embed_dim=CFG.EMBED_DIM,
    num_heads=CFG.NUM_HEADS,
    transformer_layers=CFG.TRANSFORMER_LAYERS,
    dropout=CFG.DROPOUT
)
model.to(CFG.DEVICE)

trainable = sum(p.numel() for p in model.parameters() if p.requires_grad)
total = sum(p.numel() for p in model.parameters())
print(f"Total params: {total:,}")
print(f"Trainable params: {trainable:,} ({trainable/total*100:.1f}%)")

criterion = nn.BCEWithLogitsLoss()
optimizer = optim.AdamW(model.parameters(), lr=CFG.LR, weight_decay=3e-4)

from torch.optim.lr_scheduler import CosineAnnealingWarmRestarts
scheduler = CosineAnnealingWarmRestarts(optimizer, T_0=5, T_mult=2, eta_min=1e-6)

best_auc = 0
patience_counter = 0


# ============================================
# Cell 9: Training loop
# ============================================

print("\n" + "="*60)
print("STARTING TRAINING (with preprocessed data)")
print("="*60)

for epoch in range(CFG.EPOCHS):
    print(f"\nEpoch {epoch+1}/{CFG.EPOCHS}")
    start_time = time.time()
    
    train_loss = train_epoch(model, train_loader, criterion, optimizer, CFG.DEVICE)
    valid_loss, valid_auc = valid_epoch(model, valid_loader, criterion, CFG.DEVICE)
    scheduler.step()
    
    epoch_time = time.time() - start_time
    print(f"⏱️  Time: {epoch_time/60:.1f} min | LR: {optimizer.param_groups[0]['lr']:.2e}")
    print(f"📉 Train Loss: {train_loss:.4f}")
    print(f"📊 Valid Loss: {valid_loss:.4f}, AUC: {valid_auc:.4f}")
    
    if valid_auc > best_auc:
        best_auc = valid_auc
        patience_counter = 0
        torch.save({
            'epoch': epoch,
            'model_state_dict': model.state_dict(),
            'optimizer_state_dict': optimizer.state_dict(),
            'auc': valid_auc,
            'config': {
                'backbone': CFG.BACKBONE,
                'num_slices': CFG.NUM_SLICES,
                'embed_dim': CFG.EMBED_DIM,
            }
        }, 'best_multimodal_model.pth')
        print(f"✅ Best model saved! AUC: {valid_auc:.4f}")
    else:
        patience_counter += 1
        print(f"⏳ No improvement ({patience_counter}/{CFG.PATIENCE})")
    
    if patience_counter >= CFG.PATIENCE:
        print(f"\n🛑 Early stopping at epoch {epoch+1}")
        break

print("\n" + "="*60)
print(f"🎉 TRAINING COMPLETE! Best AUC: {best_auc:.4f}")
print("="*60)


